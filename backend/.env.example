# Conexão com o Neon PostgreSQL (produção / desenvolvimento remoto).
# Use a connection string "pooled" do Neon (host com -pooler).
DATABASE_URL=

# Desenvolvimento local sem Neon: deixe DATABASE_URL vazio e o backend usa
# PGlite (PostgreSQL embutido) gravando neste diretório.
PGLITE_DATA_DIR=.data/pglite

# Conta administrativa inicial (criada automaticamente em `npm run db:migrate`
# e no build da Vercel, apenas se ainda não existir nenhum usuário).
# Defina os valores somente no ambiente (Vercel / .env local) — nunca no repositório.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Duração da sessão do painel (dias). A sessão é renovada automaticamente com o uso.
SESSION_TTL_DAYS=30

# Origem pública do site (usada na verificação de origem das requisições).
# Ex.: https://orts-jaragua.vercel.app
APP_ORIGIN=http://localhost:3000

# Porta do servidor standalone do backend (npm run dev:backend)
PORT=4000
