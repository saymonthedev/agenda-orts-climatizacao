# O frontend (Next.js) monta a API do backend em /api.
# As mesmas variáveis do backend são lidas aqui (veja backend/.env.example).
DATABASE_URL=
SESSION_TTL_DAYS=30
APP_ORIGIN=http://localhost:3000

# URL pública do site (metadados, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: código do Google Search Console (método "tag HTML"); só o valor de content="...".
GOOGLE_SITE_VERIFICATION=

# Opcional: avaliações do Perfil da Empresa no Google (seção "Avaliações" do site).
# Chave com a "Places API (New)" ativada e o ID do lugar (ChIJ…). Sem elas, a seção não aparece.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
